generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

enum TimeEntryType {
  WORK_START
  WORK_END
  LUNCH_START
  LUNCH_END
  PERSONAL_LEAVE_START
  PERSONAL_LEAVE_END
  SICK_LEAVE
}

enum AdjustmentType {
  BONUS
  PENALTY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum AuditEntityType {
  TIME_ENTRY
  SALARY_ADJUSTMENT
  EMPLOYEE
  EMPLOYEE_RATE
}

model Employee {
  id             Int       @id @default(autoincrement())
  telegramId       BigInt?   @unique
  telegramUsername String?
  firstName        String
  lastName       String
  role           Role      @default(EMPLOYEE)
  invitationCode String?   @unique
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  timeEntries             TimeEntry[]
  rates                   EmployeeRate[]
  salaryAdjustments       SalaryAdjustment[]
  auditLogs               AuditLog[]                  @relation("editor")
  notifications           Notification[]
  notificationReads       NotificationRead[]
  notificationSettings    AdminNotificationSettings?
  notificationFilters     AdminNotificationFilter[]
}

model EmployeeRate {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  rate          Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime @db.Date
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
}

model TimeEntry {
  id         Int           @id @default(autoincrement())
  employeeId Int
  type       TimeEntryType
  timestamp  DateTime
  date       DateTime      @db.Date
  note       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
  @@index([date])
}

model SalaryAdjustment {
  id         Int            @id @default(autoincrement())
  employeeId Int
  amount     Decimal        @db.Decimal(10, 2)
  type       AdjustmentType
  date       DateTime       @db.Date
  reason     String
  createdAt  DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
}

model AuditLog {
  id           Int             @id @default(autoincrement())
  editorId     Int
  action       AuditAction
  entityType   AuditEntityType
  entityId     Int
  previousData Json?
  newData      Json?
  createdAt    DateTime        @default(now())

  editor Employee @relation("editor", fields: [editorId], references: [id])

  @@index([entityType, entityId])
  @@index([editorId])
  @@index([createdAt])
}

model Notification {
  id         Int           @id @default(autoincrement())
  employeeId Int
  type       TimeEntryType
  timestamp  DateTime
  createdAt  DateTime      @default(now())

  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reads      NotificationRead[]

  @@index([createdAt])
  @@index([employeeId, createdAt])
}

model NotificationRead {
  id             Int      @id @default(autoincrement())
  notificationId Int
  adminId        Int
  readAt         DateTime @default(now())
  bookmarked     Boolean  @default(false)

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  admin          Employee     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([notificationId, adminId])
  @@index([adminId])
  @@index([adminId, bookmarked])
}

model AdminNotificationSettings {
  id                       Int      @id @default(autoincrement())
  adminId                  Int      @unique
  pushEnabled              Boolean  @default(true)
  notifyWorkStart          Boolean  @default(true)
  notifyWorkEnd            Boolean  @default(true)
  notifyLunchStart         Boolean  @default(true)
  notifyLunchEnd           Boolean  @default(true)
  notifyPersonalLeaveStart Boolean  @default(true)
  notifyPersonalLeaveEnd   Boolean  @default(true)
  notifySickLeave          Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  admin           Employee                  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  employeeFilters AdminNotificationFilter[]
}

model AdminNotificationFilter {
  id         Int @id @default(autoincrement())
  settingsId Int
  employeeId Int

  settings AdminNotificationSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  employee Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([settingsId, employeeId])
  @@index([settingsId])
}
