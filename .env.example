# Telegram Bot API token (получить у @BotFather)
BOT_TOKEN=

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schedule_app

# Bot mode: polling (разработка) | webhook (продакшн)
BOT_MODE=polling

# Webhook settings (только для BOT_MODE=webhook)
WEBHOOK_DOMAIN=https://example.com
WEBHOOK_PATH=/webhook
PORT=3000

# Telegram ID суперадмина (получить у @userinfobot)
SUPER_ADMIN_TELEGRAM_ID=

# Имя и фамилия суперадмина (опционально, по умолчанию: Влад Филимонов)
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=
